# ── Supabase (Project Settings › API) ───────────────────────────────────────
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Authentication (Supabase Auth) ──────────────────────────────────────────
# Domain of the synthetic player logins (jugador-<id>@<domain>). No email is ever
# sent there. Must match PLAYER_LOGIN_DOMAIN in scripts/.env.admin.
VITE_PLAYER_LOGIN_DOMAIN=jugadores.cdtembleque.app
# Where supabase-js keeps the session: "local" (default, survives closing the PWA)
# or "session" (cleared when the tab/app closes — for shared devices).
VITE_AUTH_STORAGE=local

# ── Cloudinary (unsigned upload preset) — optional ──────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Web push — optional ─────────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_SECRET=
